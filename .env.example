# ================================================================
# LIFORA – Blood & Organ Donation Network
# Environment Variables Template
# ================================================================
# Copy this file to .env in the PROJECT ROOT and fill in real values.
# NEVER commit .env to Git. It is in .gitignore.
#
# For Railway deployment, set these as Environment Variables in:
#   Railway Project → Service → Variables
# ================================================================

# ─── SERVER ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Set to 'production' on Railway

# ─── SUPABASE DATABASE ─────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
#
# Project URL (e.g. https://xyzabc.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# anon/public key – safe for browser clients
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# service_role key – NEVER expose to browser; backend only
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── URLS ──────────────────────────────────────────────────────
# Development:
CLIENT_URL=http://localhost:5173

# Production (update to your Railway domain after first deploy):
# CLIENT_URL=https://your-lifora-app.railway.app

# CORS allowed origins (same as CLIENT_URL for most setups)
# Multiple origins (comma-separated): http://localhost:5173,https://your-app.railway.app
CORS_ORIGIN=http://localhost:5173

# ─── EMAIL / SMTP ──────────────────────────────────────────────
# Leave blank to simulate email output to console (safe for development)
# For production, use Gmail App Password or a transactional email service (SendGrid, Resend)
#
# Gmail setup:
#   1. Enable 2FA on your Google account
#   2. Generate an App Password: Google Account → Security → App Passwords
#   3. Use that 16-character App Password below (NOT your main Gmail password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-gmail-app-password
EMAIL_FROM="LIFORA Network" <noreply@lifora.org>

# ─── ADMIN PROVISIONING (used by: node server/scripts/createAdmin.js) ────
# Set these before running the admin creation script
# Or leave blank to be prompted interactively
ADMIN_NAME=LIFORA Administrator
ADMIN_EMAIL=admin@lifora.org
ADMIN_PHONE=
ADMIN_PASSWORD=

# ─── DEV-ONLY SETTINGS ─────────────────────────────────────────
# Set to 'true' to auto-seed demo data on empty DB (development ONLY)
# This is IGNORED in production (NODE_ENV=production)
AUTO_SEED=false
