# ================================================================
# LIFORA – Client Environment Variables
# ================================================================
# Copy this file to client/.env and fill in your actual values.
# NEVER commit client/.env to Git.
# ================================================================

# ─── Supabase (Frontend Auth) ──────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
#
# Project URL (same as backend SUPABASE_URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# anon/public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# ─── API URL (only set if backend is on a SEPARATE domain) ────
# Leave commented when frontend and backend are served together
# (standard Railway monorepo deploy — Express serves React build)
# Uncomment ONLY if you deploy frontend separately (e.g. Vercel + Railway):
# VITE_API_URL=https://your-lifora-backend.railway.app

# ─── Dev Demo Logins ──────────────────────────────────────────
# Set to 'true' to show quick demo login buttons in development
# NEVER set this in production — demo buttons are automatically hidden
# when VITE_SHOW_DEMO_LOGINS is not 'true' OR when running a production build
VITE_SHOW_DEMO_LOGINS=true
